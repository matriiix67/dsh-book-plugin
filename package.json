{
  "name": "@local/dsh-bookshelf",
  "version": "0.1.0",
  "private": true,
  "description": "本地书架、沉浸阅读与带原文引用的 DSH 书架助手",
  "type": "module",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./typert": "./dist/typert.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "dist",
    "locale",
    "assets",
    "cordis.patch.yml",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "dompurify": "3.4.17",
    "domutils": "3.2.2",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "htmlparser2": "10.0.0",
    "marked": "17.0.1",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/sanitize-html": "2.16.0",
    "esbuild": "0.27.0",
    "prettier": "3.6.2",
    "react": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
